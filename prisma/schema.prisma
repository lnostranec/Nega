generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  phone             String?            @unique
  firstName         String?
  lastName          String?
  middleName        String?
  role              UserRole           @default(USER)
  points            Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orders            Order[]
  pointTransactions PointTransaction[]
  sessions          Session[]
  reviews           Review[]
  passwordResetTokens PasswordResetToken[]
  auditLogs         AdminAuditLog[]
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  text      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}

enum UserRole {
  USER
  ADMIN
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  imageUrl    String?
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  products    ProductCollection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Product {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  description  String?
  composition  String?
  care         String?
  price        Decimal
  comparePrice Decimal?
  sku          String?             @unique
  style        String?
  country      String?
  pattern      String?
  material     String?
  isActive     Boolean             @default(true)
  images       ProductImage[]
  variants     ProductVariant[]
  bottomModels ProductBottomModel[]
  setAddons    ProductSetAddon[]
  collections  ProductCollection[]
  relatedProducts ProductRelated[] @relation("ProductRelatedSource")
  relatedOf       ProductRelated[] @relation("ProductRelatedTarget")
  homepageBestsellers HomepageBestseller[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

enum VariantPart {
  STANDARD
  TOP
  BOTTOM
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  color      String?
  stock      Int         @default(0)
  sku        String?     @unique
  part       VariantPart @default(STANDARD)
  orderItems OrderItem[]
}

model ProductBottomModel {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model ProductSetAddon {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal
  imageUrl    String?
  note        String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductRelated {
  id               String  @id @default(cuid())
  productId        String
  relatedProductId String
  sortOrder        Int     @default(0)
  product          Product @relation("ProductRelatedSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product @relation("ProductRelatedTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId])
  @@index([productId])
}

model HomepageBestseller {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  status          OrderStatus    @default(PENDING)
  customerName    String?
  customerPhone   String
  customerEmail   String?
  subtotal        Decimal
  deliveryCost    Decimal        @default(0)
  promoCodeId     String?
  promoCode       PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoDiscount   Decimal        @default(0)
  loyaltyDiscount Decimal        @default(0)
  pointsUsed      Int            @default(0)
  pointsEarned    Int            @default(0)
  total           Decimal
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus  @default(PENDING)
  externalPaymentId String?      @unique
  deliveryMethod  String?
  cdekPvzCode     String?
  cdekPvzName     String?
  cdekCityCode    Int?
  cdekCityName    String?
  deliveryAddress String?
  cdekUuid        String?
  yandexClaimId   String?
  trackingNumber  String?
  comment         String?
  paymentExpiresAt DateTime?
  stockReleased   Boolean        @default(false)
  items           OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  variantId       String?
  sourceVariantId String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  name      String
  size      String?
  sizeTop     String?
  sizeBottom  String?
  bottomModel String?
  color     String?
  price     Decimal
  quantity  Int
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD
  DOLYAMI
  YANDEX_SPLIT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model PointTransaction {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  type      PointType
  orderId   String?
  note      String?
  createdAt DateTime  @default(now())
}

enum PointType {
  EARNED
  SPENT
  ADJUSTMENT
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String   @default("")
  href      String   @default("/catalog")
  imageUrl  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model SiteSettings {
  id                  String @id @default("default")
  shopName            String @default("Nega")
  pointsPercent       Int    @default(5)
  minOrderForPoints   Int    @default(0)
  cdekPvzBaseCost     Int    @default(350)
  cdekCourierBaseCost Int    @default(500)
  yandexDeliveryCost  Int    @default(450)
  freeDeliveryFrom    Int?   @default(10000)
  loyaltyThreshold1   Int    @default(10000)
  loyaltyPercent1     Int    @default(3)
  loyaltyThreshold2   Int    @default(30000)
  loyaltyPercent2     Int    @default(5)
  loyaltyThreshold3   Int    @default(50000)
  loyaltyPercent3     Int    @default(10)
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailOutbox {
  id        String      @id @default(cuid())
  to        String
  subject   String
  html      String
  template  String?
  orderId   String?
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())
}

model PromoCode {
  id             String        @id @default(cuid())
  code           String        @unique
  type           PromoCodeType @default(FIXED)
  value          Int
  minOrderAmount Int           @default(0)
  maxUses        Int?
  usedCount      Int           @default(0)
  expiresAt      DateTime?
  isActive       Boolean       @default(true)
  isGiftCert     Boolean       @default(false)
  sourceOrderId  String?
  orders         Order[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum PromoCodeType {
  FIXED
  PERCENT
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  meta       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
