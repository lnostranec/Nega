# PostgreSQL (Yandex Cloud, Neon, Supabase, …)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6432/DB?sslmode=require"

# Admin user created by `npm run db:seed` (skip if unset)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# Public site URL — set to your Vercel URL after first deploy (links in emails, payment return, sitemap)
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# Optional: transactional email (without key, emails are logged only)
# RESEND_API_KEY=
# EMAIL_FROM="Nega Shop <orders@nega.ru>"

# Protect cron endpoints: /api/cron/jobs and /api/cron/emails
# CRON_SECRET=

# Optional: display name in email templates
# SHOP_NAME=Nega

# Optional: Yandex Metrika counter id
# NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Optional: Sentry DSN (lightweight error reporting)
# SENTRY_DSN=

# --- ЮKassa (карта). Без ключей — auto-confirm ---
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_SEND_RECEIPT=1
# YOOKASSA_VAT_CODE=1
# Webhook: https://your-domain/api/payments/yookassa
# YOOKASSA_SKIP_IP_CHECK=1

# --- Долями (Т‑Банк). Без ключей — auto-confirm ---
# DOLYAMI_LOGIN=
# DOLYAMI_PASSWORD=
# DOLYAMI_API_URL=https://partner.dolyame.ru
# DOLYAMI_WEBHOOK_SECRET=
# Webhook: https://your-domain/api/payments/dolyami
# DOLYAMI_SKIP_IP_CHECK=1

# --- Яндекс Пэй / Сплит. Без ключей — auto-confirm ---
# YANDEX_PAY_API_KEY=
# YANDEX_PAY_MERCHANT_ID=
# Боевой: https://pay.yandex.ru/api/merchant/v1
# Песочница: https://sandbox.pay.yandex.ru/api/merchant/v1
# YANDEX_PAY_API_URL=https://pay.yandex.ru/api/merchant/v1
# Callback: https://your-domain/api/payments/yandex-pay

# --- СДЭК API v2 ---
# CDEK_CLIENT_ID=
# CDEK_CLIENT_SECRET=
# CDEK_BASE_URL=https://api.cdek.ru
# CDEK_FROM_CITY_CODE=44
# CDEK_TARIFF_PVZ=136
# CDEK_TARIFF_COURIER=137
# CDEK_PACKAGE_WEIGHT_G=500
# CDEK_PACKAGE_LENGTH_CM=30
# CDEK_PACKAGE_WIDTH_CM=20
# CDEK_PACKAGE_HEIGHT_CM=10

# --- Яндекс Доставка (Express). Без токена — фикс. цена из админки ---
# YANDEX_DELIVERY_TOKEN=
# YANDEX_DELIVERY_API_URL=https://b2b.taxi.yandex.net
# YANDEX_DELIVERY_FROM_ADDRESS=Москва, улица Тверская, 1
# YANDEX_DELIVERY_FROM_LAT=
# YANDEX_DELIVERY_FROM_LON=
# YANDEX_DELIVERY_CONTACT_NAME=Nega
# YANDEX_DELIVERY_CONTACT_PHONE=+79990000000
# YANDEX_DELIVERY_ITEM_WEIGHT_KG=0.5
# YANDEX_DELIVERY_ITEM_LENGTH_M=0.3
# YANDEX_DELIVERY_ITEM_WIDTH_M=0.2
# YANDEX_DELIVERY_ITEM_HEIGHT_M=0.1
