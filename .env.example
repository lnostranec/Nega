# PostgreSQL (Yandex Cloud, Neon, Supabase, …)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6432/DB?sslmode=require"

# Admin user created by `npm run db:seed` (skip if unset)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# Public site URL — set to your Vercel URL after first deploy (links in emails)
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# Optional: transactional email (without key, emails are logged only)
# RESEND_API_KEY=
# EMAIL_FROM="Nega Shop <orders@nega.ru>"

# Optional: protect POST /api/cron/emails
# CRON_SECRET=

# Optional: display name in email templates
# SHOP_NAME=Nega
